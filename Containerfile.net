FROM registry.access.redhat.com/hi/go:latest AS builder

WORKDIR /app
COPY go.mod ./
RUN go mod download || true
COPY cmd ./cmd

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /tmp/networkapp ./cmd/networkapp

FROM registry.access.redhat.com/hi/core-runtime:latest

COPY --from=builder --chmod=0755 /tmp/networkapp /app

# Do not set USER; OpenShift assigns a random non-root UID
ENTRYPOINT ["/app"]
